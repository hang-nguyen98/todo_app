<div class="container py-5">

  <!-- Intro -->
  <section class="text-center mb-5">
    <h1 class="fw-bold mb-4">
      Simple Task Management 
    </h1>

    <p class="lead text-muted mb-4">
      Create categories, organize your ToDos, and keep track of what
      you've completed.
    </p>

    <!-- App statistics -->
    <div>
      <%= get_stats(User.count, Todo.count) %>
    </div>
  </section>


  <!-- How it works -->
  <section class="pt-4 border-top">
    <div class="text-center mb-5">
      <p class="text-uppercase small fw-semibold text-muted mb-2">
        Getting started
      </p>
    </div>

    <div class="row g-4">

      <!-- Step 1 -->
      <div class="col-md-4">
        <div class="h-100 p-4 border rounded-3 bg-white">
          <div class="fs-3 mb-3">
            <i class="bi bi-folder2-open"></i>
          </div>

          <p class="small text-muted fw-semibold mb-2">
            01
          </p>

          <h3 class="h5 fw-bold">
            Create categories
          </h3>

          <p class="text-muted mb-0">
            Organize your work into categories such as School,
            Personal, or Work.
          </p>
        </div>
      </div>


      <!-- Step 2 -->
      <div class="col-md-4">
        <div class="h-100 p-4 border rounded-3 bg-white">
          <div class="fs-3 mb-3">
            <i class="bi bi-check2-square"></i>
          </div>

          <p class="small text-muted fw-semibold mb-2">
            02
          </p>

          <h3 class="h5 fw-bold">
            Add your ToDos
          </h3>

          <p class="text-muted mb-0">
            Add tasks to a category and mark important items
            as priority.
          </p>
        </div>
      </div>


      <!-- Step 3 -->
      <div class="col-md-4">
        <div class="h-100 p-4 border rounded-3 bg-white">
          <div class="fs-3 mb-3">
            <i class="bi bi-check-circle"></i>
          </div>

          <p class="small text-muted fw-semibold mb-2">
            03
          </p>

          <h3 class="h5 fw-bold">
            Track your progress
          </h3>

          <p class="text-muted mb-0">
            Mark tasks as complete and view all of your finished
            ToDos in one place.
          </p>
        </div>
      </div>

    </div>
  </section>

</div>