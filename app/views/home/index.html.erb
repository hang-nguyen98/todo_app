            class: "btn btn-app-primary btn-lg me-2" do %>
        <i class="bi bi-list-task me-2"></i>
        View My ToDos
      <% end %>

    <% else %>

      <%= link_to signup_path,
            class: "btn btn-app-primary btn-lg me-2" do %>
