<%# Todo partial that displays a list of all todos %>

<div class="col-lg-6">
  <div class="app-card todo-card p-4 h-100
    <%= 'todo-priority' if todo.priority? %>
    <%= 'todo-completed' if todo.completed? %>
  ">
    <div class="d-flex justify-content-between gap-3">
      <div>
        <div class="todo-title"><%= todo.title %></div>
        <span class="badge text-bg-light border">
          <i class="bi bi-folder me-1"></i>
          <%= todo.category.name %>
        </span>
      </div>

      <div class="text-end">
        <% if todo.priority? %>
          <span class="badge text-bg-danger status-badge">
            <i class="bi bi-exclamation-triangle me-1"></i>
            High Priority
          </span>
        <% end %>

        <% if todo.completed? %>
          <span class="badge text-bg-success status-badge">
            <i class="bi bi-check-lg me-1"></i>
            Completed
          </span>
        <% end %>
      </div>
    </div>

    <hr>

    <div class="d-flex flex-wrap gap-2">
      <%= link_to todo_path(todo), class: "btn btn-sm btn-outline-primary" do %>
        <i class="bi bi-eye me-1"></i>
        View
      <% end %>

      <%= link_to edit_todo_path(todo), class: "btn btn-sm btn-outline-secondary" do %>
        <i class="bi bi-pencil me-1"></i>
        Edit
      <% end %>

      <%= button_to todo_path(todo),
            method: :delete,
            class: "btn btn-sm btn-outline-danger",
            form: { data: { turbo_confirm: "Delete this Todo?" } } do %>
        <i class="bi bi-trash me-1"></i>
        Delete
      <% end %>
    </div>
  </div>
</div>