<div class="page-header">

  <h1 class="page-title">
    <i class="bi bi-check-circle me-2 text-success"></i>
    Completed ToDos
  </h1>

  <p class="page-subtitle">
    Everything you've finished.
  </p>

</div>


<% if @todos.any? %>

  <div class="list-group app-card overflow-hidden">

    <% @todos.each do |todo| %>

      <%= link_to todo_path(todo),
            class: "list-group-item list-group-item-action p-3" do %>

        <div class="d-flex align-items-center">

          <i class="bi bi-check-circle-fill text-success fs-5 me-3"></i>

          <div>

            <div class="fw-semibold text-decoration-line-through">
              <%= todo.title %>
            </div>

            <small class="text-secondary">
              <i class="bi bi-folder me-1"></i>
              <%= todo.category.name %>
            </small>

          </div>

          <i class="bi bi-chevron-right ms-auto text-secondary"></i>

        </div>

      <% end %>

    <% end %>

  </div>

<% else %>

  <div class="app-card empty-state">

    <i class="bi bi-check2-circle"></i>

    <h4 class="mt-3">
      Nothing completed yet
    </h4>

    <p>
      Completed tasks will appear here.
    </p>

  </div>

<% end %>