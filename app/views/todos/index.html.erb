<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center page-header">
  <div>
    <div class="page-title">
      <i class="bi bi-list-task me-2"></i>
      ToDos
    </div>
    <p class="page-subtitle">
      Manage all of your tasks in one place.
    </p>
  </div>


  <%= link_to new_todo_path,
        class: "btn btn btn-dark mt-3 mt-md-0" do %>
    <i class="bi bi-plus-lg me-1"></i>
    New ToDo
  <% end %>
</div>


<% if @todos.any? %>
  <div class="row g-3">
    <%= render partial: "todo", collection: @todos %>
  </div>
<% else %>
  <div class="alert alert-light border text-center p-4">
    <i class="bi bi-folder-plus fs-2"></i>
    <div class="h4 mt-3">No todos yet</div>
    <p class="text-secondary">Create your first ToDo to get started.</p>
  </div>

<% end %>