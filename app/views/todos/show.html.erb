<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="d-flex justify-content-between align-items-start page-header">
      <div>
        <div class="page-title">
            <i class="bi bi-journal-text me-2"></i>
          <%= @todo.title %>
        </div>

        <p class="page-subtitle">
          ToDo details
        </p>
      </div>

    </div>


    <div class="app-card p-4">
      <div class="row g-4">
        <div class="col-md-6">
          <div class="detail-label">
            Category
          </div>

          <div class="detail-value">
            <i class="bi bi-folder me-1 text-primary"></i>
            <%= @todo.category.name %>
          </div>
        </div>


        <div class="col-md-6">
          <div class="detail-label">
            Status
          </div>

          <div class="detail-value">
            <% if @todo.completed? %>
              <span class="badge text-bg-success">
                <i class="bi bi-check-circle me-1"></i>
                Completed
              </span>

            <% else %>
              <span class="badge text-bg-secondary">
                <i class="bi bi-hourglass me-1"></i>
                In Progress
              </span>
            <% end %>
          </div>
        </div>


        <div class="col-md-6">
          <div class="detail-label">
            Priority
          </div>
          <div class="detail-value">
            <% if @todo.priority? %>

              <span class="badge text-bg-danger">
                <i class="bi bi-exclamation-triangle me-1"></i>
                High
              </span>

            <% else %>
              <span class="text-secondary">
                Normal
              </span>

            <% end %>
          </div>
        </div>


        <div class="col-md-6">
          <div class="detail-label">
            Created
          </div>

          <div class="detail-value">
            <%= @todo.created_at.strftime("%B %d, %Y") %>
          </div>
        </div>

      </div>

      <hr class="my-4">

      <div class="d-flex gap-2">
        <%= link_to edit_todo_path(@todo),
              class: "btn btn-outline-secondary btn-app-secondary" do %>
          <i class="bi bi-pencil me-1"></i>
          Edit
        <% end %>

        <%= button_to todo_path(@todo),
              method: :delete,
              class: "btn btn-outline-danger",
              form: {
                data: {
                  turbo_confirm: "Are you sure?"
                }
              } do %>
          <i class="bi bi-trash me-1"></i>
          Delete

        <% end %>
      </div>
    </div>
  </div>
</div>