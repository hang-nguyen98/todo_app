<!DOCTYPE html>
<html>
  <head>
    <title>ToDo App</title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <%= javascript_importmap_tags %>
  </head>

  <body>

    <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
      <div class="container">

        <%= link_to root_path, class: "navbar-brand fw-bold" do %>
          <i class="bi bi-check2-square me-2"></i>TaskFlow
        <% end %>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNavbar"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">

          <% if logged_in? %>

            <ul class="navbar-nav me-auto mb-2 mb-lg-0">

              <li class="nav-item">
                <%= link_to todos_path, class: "nav-link" do %>
                  <i class="bi bi-list-task me-1"></i>
                  ToDos
                <% end %>
              </li>

              <li class="nav-item">
                <%= link_to categories_path, class: "nav-link" do %>
                  <i class="bi bi-folder2-open me-1"></i>
                  Categories
                <% end %>
              </li>

              <li class="nav-item">
                <%= link_to completed_todos_path, class: "nav-link" do %>
                  <i class="bi bi-check-circle me-1"></i>
                  Completed ToDos
                <% end %>
              </li>

            </ul>

            <div class="d-flex align-items-center gap-3">

            <%= link_to account_path,
                  class: "nav-link text-white" do %>

              <i class="bi bi-person-circle me-1"></i>
              Hi, <strong><%= current_user.first_name %></strong>

            <% end %>

              <%= button_to logout_path,
                    method: :delete,
                    class: "btn btn-outline-light btn-sm" do %>
                <i class="bi bi-box-arrow-right me-1"></i>
                Log Out
              <% end %>

            </div>

          <% else %>

            <div class="ms-auto d-flex gap-2">

              <%= link_to login_path, class: "btn btn-outline-light" do %>
                <i class="bi bi-box-arrow-in-right me-1"></i>
                Log In
              <% end %>

              <%= link_to signup_path, class: "btn btn-light" do %>
                <i class="bi bi-person-plus me-1"></i>
                Sign Up
              <% end %>

            </div>

          <% end %>

        </div>
      </div>
    </nav>


    <main class="container py-4">

      <% flash.each do |type, message| %>

        <% bootstrap_class =
          case type.to_s
          when "notice", "success"
            "success"
          when "alert", "danger"
            "danger"
          else
            "info"
          end
        %>

        <div
          class="alert alert-<%= bootstrap_class %> alert-dismissible fade show"
          role="alert"
        >
          <%= message %>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
          ></button>
        </div>

      <% end %>

      <%= yield %>

    </main>

  </body>
</html>