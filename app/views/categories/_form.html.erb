<%# Form partial for creating or editing a category %>
<% if category.errors.any? %>
  <div class="alert alert-danger">
    <strong>
      <i class="bi bi-exclamation-circle me-1"></i>
      Please fix the following:
    </strong>

    <ul class="mb-0 mt-2">
      <% category.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>


<%= form_with model: category do |form| %>
  <div class="mb-3">
    <%= form.label :name, class: "form-label" %>
    <%= form.text_field :name,
          class: "form-control",
          placeholder: "Example: School" %>
  </div>


  <div class="mb-4">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description,
          class: "form-control",
          rows: 4,
          placeholder: "What is this category for?" %>
  </div>


  <div class="d-flex gap-2">
    <%= form.submit category.persisted? ? "Update Category" : "Create Category",
          class: "btn btn-dark"  %>
    <%= link_to "Cancel", category.persisted? ? category_path(category) : categories_path, class: "btn btn-outline-secondary" %>
  </div>

<% end %>