<div class="d-flex justify-content-between align-items-start page-header">
  <div>
    <div class="page-title">
      <i class="bi bi-folder-fill me-2 text-primary"></i>
      <%= @category.name %>
    </div>

    <div class="page-subtitle">
      <%= @category.description %>
    </div>
  </div>


  <div class="d-flex gap-2">
    <%= link_to edit_category_path(@category),
          class: "btn btn-outline-secondary" do %>
      <i class="bi bi-pencil me-1"></i>
      Edit
    <% end %>


    <%= button_to category_path(@category),
          method: :delete,
          class: "btn btn-outline-danger",
          form: {
            data: {
              turbo_confirm:
                "Delete this category and all of its Todos?"
            }
          } do %>

      <i class="bi bi-trash me-1"></i>
      Delete

    <% end %>
  </div>
</div>


<div class="app-card p-4">
  <div class="fw-bold mb-3">
    <i class="bi bi-list-check me-2"></i>
    ToDos in this category
  </div>


  <% if @category.todos.any? %>
    <div class="row g-3">
      <%= render partial: "todos/todo", collection: @todos %>
    </div>

  <% else %>
    <div class="text-secondary">
      No ToDos belong to this category yet.
    </div>
  <% end %>
</div>