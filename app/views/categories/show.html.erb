<div class="d-flex justify-content-between align-items-start page-header">
  <div>
    <div class="page-title">
      <i class="bi bi-folder-fill me-2 text-primary"></i>
      <%= @category.name %>
    </div>

    <div class="page-subtitle">
      <%= @category.description %>
    </div>
  </div>


  <div class="d-flex gap-2">
    <%= link_to edit_category_path(@category),
          class: "btn btn-outline-secondary" do %>
      <i class="bi bi-pencil me-1"></i>
      Edit
    <% end %>


    <%= button_to category_path(@category),
          method: :delete,
          class: "btn btn-outline-danger",
          form: {
            data: {
              turbo_confirm:
                "Delete this category and all of its Todos?"
            }
          } do %>

      <i class="bi bi-trash me-1"></i>
      Delete

    <% end %>
  </div>
</div>


<div class="app-card p-4">

  <div class="fw-bold mb-3">
    <i class="bi bi-list-check me-2"></i>
    ToDos in this category
  </div>


  <% if @category.todos.any? %>

    <div class="list-group">

      <% @category.todos.each do |todo| %>
        <%= link_to todo_path(todo),
              class: "list-group-item list-group-item-action" do %>
          <div class="d-flex align-items-center">

            <% if todo.completed? %>
              <i class="bi bi-check-circle-fill text-success me-3"></i>
            <% else %>
              <i class="bi bi-circle me-3 text-secondary"></i>
            <% end %>

            <span class="<%= 'text-decoration-line-through' if todo.completed? %>">
              <%= todo.title %>
            </span>


            <% if todo.priority? %>
              <span class="badge text-bg-danger ms-auto">
                Priority
              </span>
            <% else %>
              <i class="bi bi-chevron-right ms-auto text-secondary"></i>
            <% end %>

          </div>
        <% end %>
      <% end %>

    </div>

  <% else %>

    <div class="text-secondary">
      No ToDos belong to this category yet.
    </div>

  <% end %>

</div>