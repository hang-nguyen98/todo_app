<%# Category partial that displays a list of all categories %>
<div class="col-md-6 col-lg-4">
  <div class="app-card category-card p-4 h-100">
    <div class="fs-3 text-primary mb-3">
      <i class="bi bi-folder"></i>
    </div>

    <div class="fw-bold">
      <%= category.name %>
    </div>

    <p class="text-secondary">
      <%= category.description.presence || "No description." %>
    </p>

    <div class="d-flex justify-content-between align-items-center mt-4">
      <span class="badge text-bg-light border">
        <%= category.todos.count %>
        ToDos
      </span>

      <%= link_to category_path(category),
            class: "btn btn-sm btn-outline-primary" do %>
        View
        <i class="bi bi-arrow-right ms-1"></i>
      <% end %>

    </div>
  </div>
</div>
