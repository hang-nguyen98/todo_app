<div class="d-flex justify-content-between align-items-center page-header">
  <div>
    <div class="page-title">
      <i class="bi bi-folder2-open me-2"></i>
      Categories
    </div>
    <p class="page-subtitle">
      Organize your ToDos into groups.
    </p>
  </div>


  <%= link_to new_category_path, class: "btn btn-dark" do %>
    <i class="bi bi-plus-lg me-1"></i>
    New Category
  <% end %>

</div>

<% if @categories.any? %>
  <div class="row g-3">
   <%= render partial: "category", collection: @categories %>
  </div>

<% else %>
  <div class="alert alert-light border text-center p-4">
    <i class="bi bi-folder-plus fs-2"></i>
    <div class="h4 mt-3">No categories yet</div>
    <p class="text-secondary">Create a category before adding your first ToDo.</p>
  </div>
<% end %>