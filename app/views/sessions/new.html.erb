<div class="auth-container">

  <div class="app-card auth-card">

    <div class="text-center mb-4">

      <div class="fs-1 text-primary">
        <i class="bi bi-box-arrow-in-right"></i>
      </div>

      <h1 class="h3 fw-bold">Welcome back</h1>

      <p class="text-secondary">
        Log in to continue to your ToDos.
      </p>

    </div>


    <%= form_with url: login_path, scope: :session do |form| %>

      <div class="mb-3">

        <%= form.label :email, class: "form-label" %>

        <div class="input-group">

          <span class="input-group-text">
            <i class="bi bi-envelope"></i>
          </span>

          <%= form.email_field :email,
                class: "form-control",
                placeholder: "you@example.com" %>

        </div>

      </div>


      <div class="mb-4">

        <%= form.label :password, class: "form-label" %>

        <div class="input-group">

          <span class="input-group-text">
            <i class="bi bi-lock"></i>
          </span>

          <%= form.password_field :password,
                class: "form-control",
                placeholder: "Password" %>

        </div>

      </div>


      <%= form.submit "Log In",
            class: "btn btn-app-primary w-100" %>

    <% end %>


    <p class="text-center text-secondary mt-4 mb-0">
      Don't have an account?
      <%= link_to "Create one", signup_path %>
    </p>

  </div>
</div>